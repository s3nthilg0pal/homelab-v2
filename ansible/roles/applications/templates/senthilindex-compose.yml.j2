services:
  senthilindex-api:
    image: "{{ senthilindex_image }}"
    container_name: senthilindex-api
    restart: unless-stopped
    env_file:
      - .env
    ports:
      - "{{ senthilindex_host_port }}:8080"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8080; printf 'GET /healthz HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' >&3; grep -q '200 OK' <&3"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    security_opt:
      - no-new-privileges:true
